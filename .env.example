# Foundation builds without secrets. Use auth once Supabase is configured.
GRINDLY_STAGE=foundation
APP_URL=http://localhost:3000
CHAIN_ID=46630

# Server-only; do not add NEXT_PUBLIC_ prefixes.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Required in membership stage after a verified contract deployment.
# ROBINHOOD_RPC_URL=
# MEMBERSHIP_CONTRACT_ADDRESS=
# ISSUER_PRIVATE_KEY=

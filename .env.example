# Foundation builds without secrets. Use auth once Supabase is configured.
GRINDLY_STAGE=foundation
APP_URL=http://localhost:3000
CHAIN_ID=46630
OTP_COOLDOWN_SECONDS=60
INVITATION_MAX_OTP_REQUESTS=10

# Server-only; do not add NEXT_PUBLIC_ prefixes.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# One-time SMTP configuration inputs, not exposed to the application browser.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Required in membership stage after a verified contract deployment.
# ROBINHOOD_RPC_URL=
# MEMBERSHIP_CONTRACT_ADDRESS=
# ISSUER_PRIVATE_KEY=

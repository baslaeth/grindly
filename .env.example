# Foundation builds without secrets. Use auth once Supabase is configured.
GRINDLY_STAGE=foundation
APP_URL=http://localhost:3000
CHAIN_ID=46630
OTP_COOLDOWN_SECONDS=60
INVITATION_MAX_OTP_REQUESTS=10

# Server-only; do not add NEXT_PUBLIC_ prefixes.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# One-time SMTP configuration inputs, not exposed to the application browser.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Required in membership stage after a verified contract deployment.
# ROBINHOOD_RPC_URL=
# MEMBERSHIP_CONTRACT_ADDRESS=
# ISSUER_PRIVATE_KEY=

# Preliminary AI review is disabled until the owner approves data handling.
AI_REVIEW_APPROVAL=none
# Allowed approval scopes: none, demo (isolated fixtures only), all (owner-approved private data).
# OPENAI_API_KEY=
# AI_REVIEW_MODEL=gpt-5-mini

# Optional local reasoning. Fixed loopback Ollama only; no cloud fallback.
# Source refresh never invokes a model. Enable only with owner-approved scope.
# LOCAL_AI_APPROVAL=demo
# OLLAMA_MODEL=qwen3:4b

# Optional server-only evidence adapters; public sources work without these.
# ALCHEMY_API_KEY=
# HELIUS_API_KEY=
